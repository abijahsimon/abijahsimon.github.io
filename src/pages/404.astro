---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="Not found">
  <header class="surface">
    <p class="who mono"><span>404</span><span>Nothing at this depth</span></p>
    <h1 class="name" aria-label="Not found"><span class="a">Not</span><span class="b">Found</span></h1>
    <p class="say"><a href={base}>Back to the surface</a></p>
  </header>
</Base>
