---
import '@fontsource-variable/anybody/standard.css';
import '@fontsource-variable/instrument-sans/wght.css';
import '@fontsource-variable/martian-mono/standard.css';
import '../styles/global.css';
import { me, projects, surface, basement } from '../data/projects.js';
const { title, description = me.line, current = null, theme = surface } = Astro.props;
const base = import.meta.env.BASE_URL;
const pageTitle = title ? `${title} — ${me.name}` : `${me.name} — ${me.title}`;
// Social cards need an absolute URL: it is used once `site` is set in astro.config.mjs.
const og = Astro.site ? new URL(`${base}og.png`, Astro.site).href : `${base}og.png`;
---
<!doctype html>
<html lang="en" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content={theme.bg}>
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:image" content={og}>
  <meta property="og:image:width" content="2400">
  <meta property="og:image:height" content="1260">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`}>
  <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
</head>
<body style={`--bg:${theme.bg};--fg:${theme.fg}`}>
  <a class="skip" href="#main">Skip to the work</a>

  <!-- The column: one navigation device. Closed it is a stratigraphic column; open it is the index. -->
  <nav class="rail" id="rail" aria-label="Work">
    <a class="band top" href={base} style={`--c:${surface.bg};--t:${surface.fg}`} data-band="top" aria-current={current === 'home' ? 'page' : undefined}>
      <i class="mono">00</i><b>Surface</b><span class="mono">Home</span>
    </a>
    {projects.map((p) => (
      <a class="band" href={`${base}work/${p.slug}/`} style={`--c:${p.bg};--t:${p.fg}`} data-band={p.slug} aria-current={current === p.slug ? 'page' : undefined}>
        <i class="mono">{p.n}</i><b>{p.title.join(' ')}</b><span class="mono">{p.kind} · {p.year}</span>
      </a>
    ))}
    <a class="band" href={`${base}#contact`} style={`--c:${basement.bg};--t:${basement.fg}`} data-band="contact">
      <i class="mono">→</i><b>Contact</b><span class="mono">{me.email}</span>
    </a>
    <div class="marker" id="marker" aria-hidden="true"></div>
  </nav>
  <button class="idx mono" id="idx" aria-expanded="false" aria-controls="rail"><span class="o">Index</span><span class="c">Close</span></button>

  <main id="main"><slot /></main>

  <dialog class="lb" id="lb" aria-label="Enlarged image">
    <button class="lb-x mono" id="lb-x">Close</button>
    <div class="lb-s" id="lb-s"><img id="lb-i" alt="" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="></div>
    <p class="lb-h mono" id="lb-h">Click the image to zoom · drag to move</p>
  </dialog>

  <script>import '../scripts/site.js';</script>
</body>
</html>
